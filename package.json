{
  "name": "sierradirecta",
  "version": "1.0.0",
  "private": true,
  "engines": {"node":"22.x"},
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "start:hosting": "prisma migrate deploy && tsx scripts/seed-hosting.ts && tsx server/index.ts",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "backup": "node scripts/database.mjs backup",
    "restore:test": "node scripts/database.mjs restore"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "multer": "2.5.0",
    "pg": "8.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.65.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
